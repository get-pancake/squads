{
  "version": 1,
  "jobs": [
    {
      "id": "daily-sweep",
      "schedule": {
        "kind": "cron",
        "expr": "0 9 * * *",
        "tz": "America/Los_Angeles"
      },
      "workflow": "eng.sweep_open_issues",
      "name": "Daily triage sweep"
    },
    {
      "id": "weekly-report",
      "schedule": {
        "kind": "cron",
        "expr": "0 10 * * 1",
        "tz": "America/Los_Angeles"
      },
      "workflow": "eng.weekly_report",
      "name": "Weekly issue-health report"
    }
  ]
}
