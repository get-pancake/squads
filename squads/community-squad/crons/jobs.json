{
  "version": 1,
  "jobs": [
    {
      "id": "daily-reddit-scan",
      "schedule": {
        "kind": "cron",
        "expr": "0 14 * * *",
        "tz": "America/Los_Angeles"
      },
      "workflow": "reddit.scan_and_draft",
      "name": "Daily subreddit scan + comment drafts"
    },
    {
      "id": "daily-keyword-monitor",
      "schedule": {
        "kind": "cron",
        "expr": "30 14 * * *",
        "tz": "America/Los_Angeles"
      },
      "workflow": "reddit.monitor_keywords",
      "name": "Daily brand/competitor keyword monitor"
    },
    {
      "id": "reddit-health-check",
      "schedule": {
        "kind": "cron",
        "expr": "0 10 * * 1",
        "tz": "America/Los_Angeles"
      },
      "workflow": "reddit.account_health",
      "name": "Weekly account health check"
    }
  ]
}
