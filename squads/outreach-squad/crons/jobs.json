{
  "version": 1,
  "jobs": [
    {
      "id": "daily-outbound-loop",
      "schedule": {
        "kind": "cron",
        "expr": "0 8 * * *",
        "tz": "America/Los_Angeles"
      },
      "workflow": "outreach.run_campaign",
      "name": "Daily outbound loop"
    },
    {
      "id": "reply-sweep",
      "schedule": {
        "kind": "cron",
        "expr": "0 0,2,4,6,10,12,14,16,18,20,22 * * *",
        "tz": "America/Los_Angeles"
      },
      "workflow": "outreach.triage_replies",
      "name": "Reply sweep (2h)"
    },
    {
      "id": "weekly-report",
      "schedule": {
        "kind": "cron",
        "expr": "0 9 * * 0",
        "tz": "America/Los_Angeles"
      },
      "workflow": "outreach.weekly_report",
      "name": "Weekly pipeline report"
    }
  ]
}
